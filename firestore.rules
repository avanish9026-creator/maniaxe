rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public aggregate display data; only the signed-in owner can write their own review.
    match /trakey_ratings/{userId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Public feedback list; only the signed-in owner can create/update/delete their own entry.
    match /trakey_feedback/{userId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Download events contain no user data. Public read is needed for the live
    // count query, while only authenticated Firebase sessions can create events.
    match /trakey_downloads/{downloadId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }



    // Public Maniaxe Typing leaderboard. One best score is stored per signed-in user.
    match /typing_leaderboard/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.wpm is number
        && request.resource.data.accuracy is number
        && request.resource.data.wpm >= 0
        && request.resource.data.wpm <= 1000
        && request.resource.data.accuracy >= 0
        && request.resource.data.accuracy <= 100
        && request.resource.data.displayName.size() <= 40;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else stays private by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
