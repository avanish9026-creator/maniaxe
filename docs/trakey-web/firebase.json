{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firestore.rules", "README.md", "**/.*", "**/node_modules/**"],
    "headers": [
      {"source":"**/*.js","headers":[{"key":"Cache-Control","value":"no-cache"}]},
      {"source":"index.html","headers":[{"key":"Cache-Control","value":"no-cache"}]}
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
